# Heartbeat workflow — keeps Render alive
# NOTE: Cannot be pushed without `workflow` scope on PAT
# Push manually after creating a PAT with repo + workflow scopes
name: Heartbeat
on:
  schedule:
    - cron: '*/5 * * * *'
jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Render
        run: |
          curl -sf https://aurora-bot-render.onrender.com/health || echo "Health check failed"
          curl -sf https://aurora-bot-render.onrender.com/heartbeat || echo "Heartbeat failed"
